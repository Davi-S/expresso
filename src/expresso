#!/usr/bin/env bash
#
# expresso: keep the system awake for a while.
#
# The design, and the reasons behind it, are in docs/DESIGN.md.
#
# Layers, top to bottom. Each calls only the layers below it.
#   cli     argv → validated values; prints for humans; maps results to exit codes
#   core    lock operations on validated values: on, off, status
#   values  pure functions on validated values; no I/O besides printing the result
#   system  the only code that runs external commands (not written yet)
#
# Conventions:
#   - Globals are readonly constants. Everything else is `local`.
#   - Functions return data on stdout and a status as their exit code.
#     Only `main`'s caller exits.
#   - Errors propagate explicitly with `|| return`. `set -e` is not relied on
#     inside functions, because Bash disables it in many contexts.
#   - Booleans are the strings `true` and `false`.
#   - Never do arithmetic on an unvalidated string: Bash evaluates it as an
#     expression, which can run commands. Validate with a regex first.

VERSION="1.0.2"
readonly VERSION

# Exit codes. Each has one meaning across all commands.
# TODO(rewrite step 3): drop this directive once the core uses every code.
# shellcheck disable=SC2034
readonly \
    EXIT_OK=0 \
    EXIT_NO_LOCK=1 \
    EXIT_USAGE=2 \
    EXIT_ALREADY_ON=3 \
    EXIT_SYSTEM=4

readonly MAX_DURATION=2147483647

# --- values ------------------------------------------------------------------

# is_duration STRING
# Succeeds if STRING is a DURATION: whole seconds with no sign or leading zeros,
# from 0 to MAX_DURATION. 0 means indefinite.
is_duration() {
    local -r value="$1"
    [[ "$value" =~ ^(0|[1-9][0-9]*)$ ]] || return 1
    # Compare lengths before values, so a huge number can't overflow.
    ((${#value} < ${#MAX_DURATION})) && return 0
    ((${#value} == ${#MAX_DURATION} && value <= MAX_DURATION))
}

# inhibit_what LID IDLE
# Print the systemd-inhibit --what= list: always sleep, plus the requested extras.
inhibit_what() {
    local -r lid="$1" idle="$2"
    local what="sleep"
    if [[ "$lid" == true ]]; then
        what+=":handle-lid-switch"
    fi
    if [[ "$idle" == true ]]; then
        what+=":idle"
    fi
    printf '%s\n' "$what"
}

# format_status DURATION STARTED LID IDLE NOW
# Print the `status` output for a running lock. All arguments must be validated.
format_status() {
    local -r duration="$1" started="$2" lid="$3" idle="$4" now="$5"
    local until remaining
    if ((duration == 0)); then
        until=infinity
        remaining=infinity
    else
        until=$((started + duration))
        remaining=$((until > now ? until - now : 0))
    fi
    printf '%s\n' \
        "state=on" \
        "duration=$duration" \
        "started=$started" \
        "until=$until" \
        "remaining=$remaining" \
        "lid=$lid" \
        "idle=$idle"
}

# --- core --------------------------------------------------------------------
# Placeholders until the system layer exists (step 3 of the rewrite).

core_on() {
    err "'on' is not implemented yet"
    return "$EXIT_SYSTEM"
}

core_off() {
    err "'off' is not implemented yet"
    return "$EXIT_SYSTEM"
}

core_status() {
    err "'status' is not implemented yet"
    return "$EXIT_SYSTEM"
}

# --- cli ---------------------------------------------------------------------

# err MESSAGE: print an error message to stderr.
err() {
    printf 'expresso: %s\n' "$1" >&2
}

# usage_error MESSAGE: report a usage error. Returns EXIT_USAGE, so callers can
# write `check || usage_error "..." || return`.
usage_error() {
    err "$1"
    printf "Try 'expresso --help' for more information.\n" >&2
    return "$EXIT_USAGE"
}

cli_help() {
    cat <<EOF
Usage: expresso on DURATION [--lid] [--idle]
       expresso off
       expresso status
       expresso --help | --version

Keep the system awake: while a lock is on, the system does not suspend.

Commands:
  on DURATION  Hold a lock for DURATION seconds, or until 'off' if DURATION is 0.
      --lid    Also keep closing the laptop lid from suspending.
      --idle   Also keep the screen from dimming, locking or turning off.
  off          Release the lock.
  status       Print the lock state as key=value lines.

Exit codes: 0 success or lock on, 1 no lock, 2 usage error,
            3 lock already on, 4 system error.

See 'man expresso' for details.
EOF
}

# cli_no_args COMMAND ARG...
# Succeeds if COMMAND was given no arguments.
cli_no_args() {
    local -r command="$1"
    shift
    (($# == 0)) || usage_error "'$command' takes no arguments"
}

# cli_parse_on ARG...
# Validate the arguments of `on`. Prints "DURATION LID IDLE".
cli_parse_on() {
    local duration="" lid=false idle=false arg
    for arg in "$@"; do
        case "$arg" in
        --lid)
            [[ "$lid" == false ]] || usage_error "option '--lid' given twice" || return
            lid=true
            ;;
        --idle)
            [[ "$idle" == false ]] || usage_error "option '--idle' given twice" || return
            idle=true
            ;;
        -*[!0-9]* | -)
            usage_error "unknown option '$arg'" || return
            ;;
        *)
            # Also reached by negative numbers, which is_duration rejects.
            [[ -z "$duration" ]] || usage_error "unexpected argument '$arg'" || return
            is_duration "$arg" ||
                usage_error "invalid DURATION '$arg': expected whole seconds from 0 to $MAX_DURATION" ||
                return
            duration="$arg"
            ;;
        esac
    done
    [[ -n "$duration" ]] || usage_error "missing DURATION" || return
    printf '%s %s %s\n' "$duration" "$lid" "$idle"
}

cli_on() {
    local request duration lid idle
    request="$(cli_parse_on "$@")" || return
    read -r duration lid idle <<<"$request"
    core_on "$duration" "$lid" "$idle"
}

main() {
    (($# > 0)) || usage_error "missing command" || return
    local -r command="$1"
    shift
    case "$command" in
    on)
        cli_on "$@"
        ;;
    off)
        cli_no_args "$command" "$@" || return
        core_off
        ;;
    status)
        cli_no_args "$command" "$@" || return
        core_status
        ;;
    --help)
        cli_no_args "$command" "$@" || return
        cli_help
        ;;
    --version)
        cli_no_args "$command" "$@" || return
        printf 'expresso %s\n' "$VERSION"
        ;;
    *)
        usage_error "unknown command '$command'"
        ;;
    esac
}

# Run only when executed, not when sourced (the tests source this file).
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    set -euo pipefail
    main "$@"
fi

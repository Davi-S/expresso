#!/usr/bin/env bash
#
# expresso: keep the system awake for a while.
#
# The design, and the reasons behind it, are in docs/DESIGN.md.
#
# Layers, top to bottom. Each calls only the layers below it.
#   cli     argv -> validated values; prints messages; maps results to exit codes
#   core    lock operations on validated values: on, off, status
#   system  the only code that runs external commands; validates what they
#           return and reports its own failures
#   values  pure functions: no I/O besides printing the result
#
# Conventions:
#   - Globals are readonly constants. Everything else is `local`.
#   - Functions return data on stdout and a status as their exit code.
#     Only `main`'s caller exits.
#   - Errors propagate explicitly with `|| return`. `set -e` is not relied on
#     inside functions, because Bash disables it in many contexts.
#   - The layer that detects a problem reports it, except the core: it returns
#     a code, and the cli turns it into a message.
#   - Booleans are the strings `true` and `false`.
#   - Never do arithmetic on an unvalidated string: Bash evaluates it as an
#     expression, which can run commands. Validate with a regex first.

VERSION="2.0.0"
readonly VERSION

# Exit codes. Each has one meaning across all commands.
readonly EXIT_NO_LOCK=1
readonly EXIT_USAGE=2
readonly EXIT_ALREADY_ON=3
readonly EXIT_SYSTEM=4

readonly MAX_DURATION=2147483647

# The systemd user unit that holds the lock. It exists only while a lock is on.
readonly UNIT="app-expresso.service"

# Watches logind's signals. The one that matters is PrepareForSleep(false),
# sent on resume; any signal only makes the waiter recheck the clock.
readonly LOGIND_MONITOR=(gdbus monitor --system
    --dest org.freedesktop.login1 --object-path /org/freedesktop/login1)

# This script's absolute path, for the unit to run `_wait` and `_stopped`.
SELF="${BASH_SOURCE[0]}"
[[ "$SELF" == /* ]] || SELF="$PWD/$SELF"
readonly SELF

# --- values ------------------------------------------------------------------

# is_duration STRING
# Succeeds if STRING is a DURATION: whole seconds with no sign or leading zeros,
# from 0 to MAX_DURATION. 0 means indefinite.
is_duration() {
    local -r value="$1"
    [[ "$value" =~ ^(0|[1-9][0-9]*)$ ]] || return 1
    # Compare lengths before values, so a huge number can't overflow.
    ((${#value} < ${#MAX_DURATION})) && return 0
    ((${#value} == ${#MAX_DURATION} && value <= MAX_DURATION))
}

# is_timestamp STRING
# Succeeds if STRING is a Unix timestamp: at most 12 digits (year 33658), which
# leaves room to add any DURATION without overflow.
is_timestamp() {
    [[ "$1" =~ ^(0|[1-9][0-9]{0,11})$ ]]
}

# is_bool STRING
is_bool() {
    [[ "$1" == true || "$1" == false ]]
}

# is_safe_path STRING
# Succeeds if STRING is an absolute path systemd reads literally: no spaces,
# quotes, `$` or `%`, which systemd would split, unquote or expand.
is_safe_path() {
    [[ "$1" =~ ^/[A-Za-z0-9/._+-]+$ ]]
}

# inhibit_what LID IDLE
# Print the systemd-inhibit --what= list: always sleep, plus the requested extras.
inhibit_what() {
    local -r lid="$1" idle="$2"
    local what="sleep"
    if [[ "$lid" == true ]]; then
        what+=":handle-lid-switch"
    fi
    if [[ "$idle" == true ]]; then
        what+=":idle"
    fi
    printf '%s\n' "$what"
}

# parse_lock_values DURATION STARTED LID IDLE
# Validate a lock's values, as stored in the unit's environment. Prints them
# space-separated, in this order.
parse_lock_values() {
    is_duration "$1" || return 1
    is_timestamp "$2" || return 1
    is_bool "$3" || return 1
    is_bool "$4" || return 1
    printf '%s %s %s %s\n' "$1" "$2" "$3" "$4"
}

# parse_unit_properties TEXT
# Parse the output of `systemctl show --property=ActiveState --property=Environment`.
# Prints "inactive", or "active DURATION STARTED LID IDLE" for a running lock.
# Fails if the unit is active but lacks valid expresso values.
parse_unit_properties() {
    local line active_state="" environment=""
    while IFS= read -r line; do
        case "$line" in
        ActiveState=*) active_state="${line#*=}" ;;
        Environment=*) environment="${line#*=}" ;;
        esac
    done <<<"$1"

    if [[ "$active_state" != active ]]; then
        printf 'inactive\n'
        return 0
    fi

    local variables variable duration="" started="" lid="" idle=""
    read -ra variables <<<"$environment"
    for variable in "${variables[@]}"; do
        case "$variable" in
        EXPRESSO_DURATION=*) duration="${variable#*=}" ;;
        EXPRESSO_STARTED=*) started="${variable#*=}" ;;
        EXPRESSO_LID=*) lid="${variable#*=}" ;;
        EXPRESSO_IDLE=*) idle="${variable#*=}" ;;
        esac
    done
    local values
    values="$(parse_lock_values "$duration" "$started" "$lid" "$idle")" || return 1
    printf 'active %s\n' "$values"
}

# format_status DURATION STARTED LID IDLE NOW
# Print the `status` output for a running lock. All arguments must be validated.
format_status() {
    local -r duration="$1" started="$2" lid="$3" idle="$4" now="$5"
    local until remaining
    if ((duration == 0)); then
        until=infinity
        remaining=infinity
    else
        until=$((started + duration))
        remaining=$((until > now ? until - now : 0))
    fi
    printf '%s\n' \
        "state=on" \
        "duration=$duration" \
        "started=$started" \
        "until=$until" \
        "remaining=$remaining" \
        "lid=$lid" \
        "idle=$idle"
}

# format_until DEADLINE NOW
# Print when a lock ends, for a notification: the time if it is today, the
# weekday and time within 6 days, the full date otherwise. Always in English.
format_until() {
    local -r deadline="$1" now="$2"
    local LC_ALL=C deadline_day now_day
    printf -v deadline_day '%(%F)T' "$deadline"
    printf -v now_day '%(%F)T' "$now"
    if [[ "$deadline_day" == "$now_day" ]]; then
        printf '%(Until %H:%M)T\n' "$deadline"
    elif ((deadline - now < 6 * 86400)); then
        printf '%(Until %a %H:%M)T\n' "$deadline"
    else
        printf '%(Until %F %H:%M)T\n' "$deadline"
    fi
}

# format_left SECONDS
# Print the time left, for a notification, in its two largest units: "2d 3h
# left", "1h 5m left", "29m left" or "45s left". Rounded down, so it never
# shows more time than there is.
format_left() {
    local -r seconds="$1"
    if ((seconds >= 86400)); then
        printf '%dd %dh left\n' $((seconds / 86400)) $((seconds % 86400 / 3600))
    elif ((seconds >= 3600)); then
        printf '%dh %dm left\n' $((seconds / 3600)) $((seconds % 3600 / 60))
    elif ((seconds >= 60)); then
        printf '%dm left\n' $((seconds / 60))
    else
        printf '%ds left\n' "$seconds"
    fi
}

# describe_lock DURATION STARTED LID IDLE NOW LEFT
# Print the body of an "Expresso on" notification, e.g. "Until 15:40 - lid, idle".
# With LEFT true, a timed lock also shows the time left: "Until 15:40 (29m left)".
describe_lock() {
    local -r duration="$1" started="$2" lid="$3" idle="$4" now="$5" left="$6"
    local text flags=""
    if ((duration == 0)); then
        text="Indefinitely"
    else
        local -r until=$((started + duration))
        text="$(format_until "$until" "$now")"
        if [[ "$left" == true ]]; then
            text+=" ($(format_left $((until > now ? until - now : 0))))"
        fi
    fi
    if [[ "$lid" == true ]]; then
        flags="lid"
    fi
    if [[ "$idle" == true ]]; then
        flags="${flags:+$flags, }idle"
    fi
    printf '%s%s\n' "$text" "${flags:+ - $flags}"
}

# stop_reason EXIT_CODE EXIT_STATUS
# Map systemd's exit information for the unit's main process to why the lock
# ended: "timeout" (the waiter finished), "stopped" (it was killed, as by
# `expresso off`) or "failed" (anything else, including no information).
stop_reason() {
    case "$1:$2" in
    exited:0) printf 'timeout\n' ;;
    killed:*) printf 'stopped\n' ;;
    *) printf 'failed\n' ;;
    esac
}

# --- system ------------------------------------------------------------------

# err MESSAGE: print an error message to stderr.
err() {
    printf 'expresso: %s\n' "$1" >&2
}

# sys_now: print the current Unix time.
sys_now() {
    local now
    if ! now="$(date +%s)" || ! is_timestamp "$now"; then
        err "could not read the current time"
        return "$EXIT_SYSTEM"
    fi
    printf '%s\n' "$now"
}

# sys_unit_state
# Print the lock's state as parse_unit_properties does: "inactive", or
# "active DURATION STARTED LID IDLE".
sys_unit_state() {
    local properties
    properties="$(systemctl --user show --property=ActiveState --property=Environment "$UNIT")" || {
        err "could not read the lock state from systemd"
        return "$EXIT_SYSTEM"
    }
    parse_unit_properties "$properties" || {
        err "$UNIT is running but was not started by this version of expresso"
        return "$EXIT_SYSTEM"
    }
}

# sys_unit_start DURATION STARTED LID IDLE
# Start the lock unit. The unit runs `_wait` inside systemd-inhibit, so the lock
# is held exactly as long as `_wait` runs, and `_stopped` when it stops.
sys_unit_start() {
    local -r duration="$1" started="$2" lid="$3" idle="$4"
    is_safe_path "$SELF" || {
        err "cannot run from '$SELF': the path may only contain letters, digits and / . _ + -"
        return "$EXIT_SYSTEM"
    }
    local what
    what="$(inhibit_what "$lid" "$idle")"
    systemd-run --user --quiet --collect \
        --unit="$UNIT" --slice=app.slice \
        --description="expresso: keep the system awake" \
        --setenv=EXPRESSO_STARTED="$started" \
        --setenv=EXPRESSO_DURATION="$duration" \
        --setenv=EXPRESSO_LID="$lid" \
        --setenv=EXPRESSO_IDLE="$idle" \
        --property=ExecStopPost="$SELF _stopped" \
        -- systemd-inhibit --what="$what" --who=expresso --why="expresso on" --mode=block \
        "$SELF" _wait || {
        err "could not start the lock"
        return "$EXIT_SYSTEM"
    }
}

# sys_unit_stop: stop the lock unit. Returns once it is fully stopped.
sys_unit_stop() {
    systemctl --user stop "$UNIT" || {
        err "could not stop the lock"
        return "$EXIT_SYSTEM"
    }
}

# sys_lock_env
# Print the lock's values from the environment the unit gives `_wait`:
# "DURATION STARTED LID IDLE".
sys_lock_env() {
    parse_lock_values "${EXPRESSO_DURATION-}" "${EXPRESSO_STARTED-}" \
        "${EXPRESSO_LID-}" "${EXPRESSO_IDLE-}" || {
        err "missing or invalid EXPRESSO_* variables; '_wait' is run by the lock unit"
        return "$EXIT_SYSTEM"
    }
}

# sys_stop_reason
# Print why the unit's main process ended, from the variables systemd gives
# ExecStopPost: see stop_reason.
sys_stop_reason() {
    stop_reason "${EXIT_CODE-}" "${EXIT_STATUS-}"
}

# sys_notify URGENCY TITLE BODY
sys_notify() {
    notify-send --app-name=expresso --expire-time=2000 --urgency="$1" "$2" "$3" || {
        err "could not send a notification"
        return "$EXIT_SYSTEM"
    }
}

# sys_wait_until DEADLINE
# Return once the wall clock reaches DEADLINE, including right after a resume
# from suspend, when `sleep` alone would be late (it doesn't count suspended time).
sys_wait_until() {
    local -r deadline="$1"
    local now fd line watching=true
    local -i code=0 status

    # Started before the first clock check, so no resume can be missed.
    exec {fd}< <(exec "${LOGIND_MONITOR[@]}")
    local -r monitor_pid=$!

    while true; do
        now="$(sys_now)" || {
            code=$?
            break
        }
        ((now < deadline)) || break
        if [[ "$watching" == true ]]; then
            # Returns on a logind signal (status 0), at the deadline (> 128),
            # or at once if the monitor died (1).
            status=0
            read -r -t "$((deadline - now))" -u "$fd" line || status=$?
            if ((status > 0 && status <= 128)); then
                watching=false
                err "cannot watch logind for resume; after a suspend, the lock may end late"
            fi
        else
            sleep "$((deadline - now))" || true
        fi
    done

    kill "$monitor_pid" 2>/dev/null || true
    exec {fd}<&-
    return "$code"
}

# sys_wait_forever: return only when killed.
sys_wait_forever() {
    sleep infinity
}

# --- core --------------------------------------------------------------------

# core_on DURATION LID IDLE
core_on() {
    local -r duration="$1" lid="$2" idle="$3"
    local state now
    state="$(sys_unit_state)" || return
    [[ "$state" == inactive ]] || return "$EXIT_ALREADY_ON"
    now="$(sys_now)" || return
    sys_unit_start "$duration" "$now" "$lid" "$idle"
}

core_off() {
    local state
    state="$(sys_unit_state)" || return
    [[ "$state" != inactive ]] || return "$EXIT_NO_LOCK"
    sys_unit_stop
}

# core_status NOTIFY
# Print the status record and, with NOTIFY true, also show the state as a
# notification. Returns EXIT_NO_LOCK when off.
core_status() {
    local -r notify="$1"
    local state now
    state="$(sys_unit_state)" || return
    if [[ "$state" == inactive ]]; then
        printf 'state=off\n'
        if [[ "$notify" == true ]]; then
            sys_notify normal "Expresso off" "No lock is on" || return
        fi
        return "$EXIT_NO_LOCK"
    fi
    local duration started lid idle
    read -r _ duration started lid idle <<<"$state"
    now="$(sys_now)" || return
    format_status "$duration" "$started" "$lid" "$idle" "$now"
    if [[ "$notify" == true ]]; then
        sys_notify normal "Expresso on" \
            "$(describe_lock "$duration" "$started" "$lid" "$idle" "$now" true)" || return
    fi
}

# core_wait
# Run by the unit inside systemd-inhibit, so the lock is held while this runs.
# Announces the lock, then holds it until the deadline.
core_wait() {
    local values duration started lid idle now body
    values="$(sys_lock_env)" || return
    read -r duration started lid idle <<<"$values"
    now="$(sys_now)" || return
    body="$(describe_lock "$duration" "$started" "$lid" "$idle" "$now" false)"
    # Holding the lock matters more than announcing it.
    sys_notify normal "Expresso on" "$body" || true
    if ((duration == 0)); then
        sys_wait_forever
    else
        sys_wait_until $((started + duration))
    fi
}

# core_stopped
# Run by systemd after the unit stops, for any reason: announces how it ended.
core_stopped() {
    case "$(sys_stop_reason)" in
    timeout) sys_notify normal "Expresso off" "Time's up" ;;
    stopped) sys_notify normal "Expresso off" "Turned off" ;;
    *) sys_notify critical "Expresso failed" "Could not take the lock. See: journalctl --user -u ${UNIT%.service}" ;;
    esac
}

# --- cli ---------------------------------------------------------------------

# usage_error MESSAGE: report a usage error. Returns EXIT_USAGE, so callers can
# write `check || usage_error "..." || return`.
usage_error() {
    err "$1"
    printf "Try 'expresso --help' for more information.\n" >&2
    return "$EXIT_USAGE"
}

cli_help() {
    cat <<EOF
Usage: expresso on DURATION [--lid] [--idle]
       expresso off
       expresso status [--notify]
       expresso --help | --version

Keep the system awake: while a lock is on, the system does not suspend.

Commands:
  on DURATION  Hold a lock for DURATION seconds, or until 'off' if DURATION is 0.
      --lid    Also keep closing the laptop lid from suspending.
      --idle   Also keep the screen from dimming, locking or turning off.
  off          Release the lock.
  status       Print the lock state as key=value lines.
      --notify Also show the state as a desktop notification.

Exit codes: 0 success or lock on, 1 no lock, 2 usage error,
            3 lock already on, 4 system error.

See 'man expresso' for details.
EOF
}

# cli_no_args COMMAND ARG...
# Succeeds if COMMAND was given no arguments.
cli_no_args() {
    local -r command="$1"
    shift
    (($# == 0)) || usage_error "'$command' takes no arguments"
}

# cli_parse_on ARG...
# Validate the arguments of `on`. Prints "DURATION LID IDLE".
cli_parse_on() {
    local duration="" lid=false idle=false arg
    for arg in "$@"; do
        case "$arg" in
        --lid)
            [[ "$lid" == false ]] || usage_error "option '--lid' given twice" || return
            lid=true
            ;;
        --idle)
            [[ "$idle" == false ]] || usage_error "option '--idle' given twice" || return
            idle=true
            ;;
        -*[!0-9]* | -)
            usage_error "unknown option '$arg'" || return
            ;;
        *)
            # Also reached by negative numbers, which is_duration rejects.
            [[ -z "$duration" ]] || usage_error "unexpected argument '$arg'" || return
            is_duration "$arg" ||
                usage_error "invalid DURATION '$arg': expected whole seconds from 0 to $MAX_DURATION" ||
                return
            duration="$arg"
            ;;
        esac
    done
    [[ -n "$duration" ]] || usage_error "missing DURATION" || return
    printf '%s %s %s\n' "$duration" "$lid" "$idle"
}

cli_on() {
    local request duration lid idle
    request="$(cli_parse_on "$@")" || return
    read -r duration lid idle <<<"$request"
    core_on "$duration" "$lid" "$idle" && return
    local -r code=$?
    if ((code == EXIT_ALREADY_ON)); then
        err "a lock is already on; run 'expresso off' first"
    fi
    return "$code"
}

cli_off() {
    cli_no_args off "$@" || return
    core_off && return
    local -r code=$?
    if ((code == EXIT_NO_LOCK)); then
        err "no lock is on"
    fi
    return "$code"
}

# cli_parse_status ARG...
# Validate the arguments of `status`. Prints NOTIFY.
cli_parse_status() {
    local notify=false arg
    for arg in "$@"; do
        case "$arg" in
        --notify)
            [[ "$notify" == false ]] || usage_error "option '--notify' given twice" || return
            notify=true
            ;;
        -*) usage_error "unknown option '$arg'" || return ;;
        *) usage_error "unexpected argument '$arg'" || return ;;
        esac
    done
    printf '%s\n' "$notify"
}

cli_status() {
    local notify
    notify="$(cli_parse_status "$@")" || return
    core_status "$notify"
}

main() {
    (($# > 0)) || usage_error "missing command" || return
    local -r command="$1"
    shift
    case "$command" in
    on) cli_on "$@" ;;
    off) cli_off "$@" ;;
    status) cli_status "$@" ;;
    --help)
        cli_no_args "$command" "$@" || return
        cli_help
        ;;
    --version)
        cli_no_args "$command" "$@" || return
        printf 'expresso %s\n' "$VERSION"
        ;;
    # Internal: run by the lock unit, not by users (see docs/DESIGN.md).
    _wait)
        cli_no_args "$command" "$@" || return
        core_wait
        ;;
    _stopped)
        cli_no_args "$command" "$@" || return
        core_stopped
        ;;
    *) usage_error "unknown command '$command'" ;;
    esac
}

# Run only when executed, not when sourced (the tests source this file).
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    set -euo pipefail
    main "$@"
fi
